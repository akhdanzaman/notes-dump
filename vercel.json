{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/spreadsheets/sync/worker.ts": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "spreadsheet-mutations",
          "maxConcurrency": 1,
          "maxDeliveries": 10000,
          "retryAfterSeconds": 30
        }
      ]
    }
  }
}
